    <fogged>false</fogged>
    <size>(4, 1, 4)</size>
    <destroyAllThing>true</destroyAllThing>
    <commonality>1</commonality>
    <faction>MapFaction</faction>
	<terrainsRect>
      <li>
        <key>PackedDirt</key>
        <value>
          <li>(4,4,5,5)</li>
        </value>
      </li>
    </terrainsRect>
	<customSteps>
	  <li Class="LoGiQ.GenStep_MapPartAdv">
        <count>2~3</count>
        <set>
          <tags>
			<LoGiQ_MapPart_Village_Living>0.5</LoGiQ_MapPart_Village_Living>
			<LoGiQ_MapPart_Village_Admin>0.2</LoGiQ_MapPart_Village_Admin>
          </tags>
        </set>
		<zone>Center</zone>
      </li>
	  <li Class="LoGiQ.GenStep_MapPartAdv">
        <count>3~6</count>
        <set>
          <tags>
		    <LoGiQ_MapPart_Village_Storage>0.6</LoGiQ_MapPart_Village_Storage>
            <LoGiQ_MapPart_Village_Production>0.5</LoGiQ_MapPart_Village_Production>
			<LoGiQ_MapPart_Village_Farm>0.5</LoGiQ_MapPart_Village_Farm>
			<LoGiQ_MapPart_Village_Living>0.3</LoGiQ_MapPart_Village_Living>
          </tags>
        </set>
		<zone>AroundCenter</zone>
      </li>
	</customSteps>
  </QuestEditor_Library.CustomMapDataDef>
