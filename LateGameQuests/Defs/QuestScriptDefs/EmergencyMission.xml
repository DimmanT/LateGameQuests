<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <QuestScriptDef>
    <defName>LoGiQ_EmergencyMission</defName>
    <root Class="QuestNode_Sequence">
      <nodes>
		<!-- . . . . . . Get asker  . . . . . . -->
	    <li Class="LoGiQ.QuestNodes.QuestNode_GetFactionAdv">
          <storeAs>askerFaction</storeAs>
          <allowEnemy>false</allowEnemy>
          <allowNeutral>true</allowNeutral>
          <allowAlly>true</allowAlly>
          <allowAskerFaction>true</allowAskerFaction>
          <allowPermanentEnemy>false</allowPermanentEnemy>
          <mustBePermanentEnemy>false</mustBePermanentEnemy>
          <leaderMustBeSafe>False</leaderMustBeSafe>
          <mustHaveGoodwillRewardsEnabled>False</mustHaveGoodwillRewardsEnabled>
		  <!-- <minTechLevel>Tribal</minTechLevel> -->
		  <!-- <maxTechLevel>Industrial</maxTechLevel> -->
        </li>
		<!-- . . . Gen map . . . -->
        <li Class="QuestEditor_Library.QuestNode_RandomCustomMap">
          <datas>
			<li><key>LoGiQ_Map_EmergencyMission_VillageRoot</key><value>1</value></li>
		  </datas>
          <buffer>10</buffer>
          <bufferMin>20</bufferMin>
          <expandingIconPath>Things/Sites/village_in_fire</expandingIconPath>
          <replaceMapGeneration>False</replaceMapGeneration>
          <enableBlack>True</enableBlack>
          <storeAs>site</storeAs>
          <distance>
            <min>6</min>
            <max>10</max>
          </distance>
          <blacklist />
        </li>
		<li Class="QuestNode_Signal">
          <inSignal>site.MapGenerated</inSignal>
		  <outSignals><li>InitCQF</li></outSignals>
          <node Class="QuestNode_Sequence">
            <nodes>
			  <li Class="QuestNode_Letter">
				<label>Temp letter</label>
				<letterDef>NeutralEvent</letterDef>
				<text>temp text</text>
			  </li>
            </nodes>
          </node>
        </li>
		<li Class="LoGiQ.QuestNodes.QuestNode_GameConditionSite">
		  <inSignal>InitCQF</inSignal>
		  <removeSignal>AllPeopleEvacuatedOrDead</removeSignal>
		  <gameCondition>LoGiQ_GameCondition_EmergencyOperation_FireEvent</gameCondition>
		  <targetWorld>false</targetWorld>
		  <duration>-1</duration>
		  <site>$site</site>
		</li>
		<li Class="QuestNode_WorldObjectTimeout">
		  <worldObject>$site</worldObject>
		  <delayTicks>$(randInt(24,48)*5000)</delayTicks>
		  <inSignalDisable>site.MapGenerated</inSignalDisable>
		  <destroyOnCleanup>true</destroyOnCleanup>
		</li>
		<!-- . . . . . . . . . . -->
		<!-- . . . . . . . . Progress. . . . . . . . -->
		<li Class="LoGiQ.QuestNodes.QuestNode_ProgressComplex">
		   	<inSignals>
				<li>AnyPersonSaved</li>
			</inSignals>
			<increments>
				<li>1</li>
			</increments>
		   <progressMax>100</progressMax>
		   <progressMin>0</progressMin>
		   <progressMessage></progressMessage>
		   <progressName>VillagersSaved</progressName>
		   <outSignalComplete>AllPeopleEvacuatedOrDead</outSignalComplete>
	    </li>
		<!-- . . . . . . . . . . . . . . . . . . . .  -->
		<!-- . . . . . . . . REWARDS . . . . . . . . -->
		<li Class="QuestNode_Set">
          <name>pointsDivTen</name>
          <value>$(0.1*$points)</value>
		  <convertTo>Int32</convertTo>
        </li>
		<li Class="QuestNode_Set">
          <name>rewardValue</name>
          <value>$(randInt(15,20)*$pointsDivTen)</value>
		  <convertTo>Int32</convertTo>
        </li>
		<li Class="QuestNode_GetMap"/>
		<li Class="LoGiQ.QuestNodes.QuestNode_ProgressGiveReward">
		  <inSignal>AllPeopleEvacuatedOrDead</inSignal>
		  <progressMin>100</progressMin>
		  <progressMax>0</progressMax>
		  <progressName>VillagersSaved</progressName>
		  <maxReward>$rewardValue</maxReward>
		</li>
		<!-- . . . . . . . . . . -->
		<!-- . . . GOALS . . . . -->
		<li Class="LoGiQ.QuestNodes.QuestNode_Goals">
			<mandatory>
				<li Class="LoGiQ.QuestNodes.GoalProgress">
					<label>LoGiQ_GoalLabel_VillagersSaved</label>
					<progressName>VillagersSaved</progressName>
				</li>
			</mandatory>
		</li>
		<!-- . . . . . . . . . . -->
		<!-- . . . Ending  . . . -->
		<!-- FINISH SUCCESS when no one pawn left -->
        <li Class="QuestNode_End">
          <inSignal>AllPeopleEvacuatedOrDead</inSignal>
		  <sendStandardLetter>true</sendStandardLetter>
          <outcome>Success</outcome>
        </li>
	  </nodes>
    </root>
    <randomlySelectable>False</randomlySelectable>
	<!-- <decreeTags><li>LoGiQ_Random</li></decreeTags> -->
	<decreeSelectionWeight>0</decreeSelectionWeight>
    <rootSelectionWeight>1.25</rootSelectionWeight>
    <rootMinPoints>500</rootMinPoints>
    <rootIncreasesPopulation>False</rootIncreasesPopulation>
    <minRefireDays>8</minRefireDays>
	<rootEarliestDay>1</rootEarliestDay>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription -&gt; People from [askerFaction_name] asking us for help. An event of fire is occured in one of their settlement. They are begging you to rescue peaple from danger. The will pay [rewardValue_money] if all people will be saved.</li>
      </rulesStrings>
      <rulesFiles />
      <rulesRaw IsNull="True" />
      <include IsNull="True" />
    </questDescriptionRules>
    <questNameRules>
      <rulesStrings>
        <li>questName -&gt; Emergency operation</li>
		<li>questName -&gt; Emergency mission</li>
		<li>questName -&gt; Call to firefighters</li>
		<li>questName -&gt; Near settlement is on fire</li>
      </rulesStrings>
      <rulesFiles />
      <rulesRaw IsNull="True" />
      <include IsNull="True" />
    </questNameRules>
    <autoAccept>true</autoAccept>
    <hideOnCleanup>False</hideOnCleanup>
    <nameMustBeUnique>False</nameMustBeUnique>
    <defaultChallengeRating>1</defaultChallengeRating>
    <defaultHidden>False</defaultHidden>
    <isRootSpecial>True</isRootSpecial>
    <canGiveRoyalFavor>True</canGiveRoyalFavor>
    <questAvailableLetterTextIsDescription>False</questAvailableLetterTextIsDescription>
    <hideInvolvedFactionsInfo>False</hideInvolvedFactionsInfo>
    <affectedByPopulation>False</affectedByPopulation>
    <affectedByPoints>True</affectedByPoints>
    <defaultCharity>False</defaultCharity>
    <sendAvailableLetter>True</sendAvailableLetter>
    <epic>False</epic>
    <endOnColonyMove>True</endOnColonyMove>
    <everAcceptableInSpace>False</everAcceptableInSpace>
    <neverPossibleInSpace>False</neverPossibleInSpace>
    <givenBy />
    <canOccurOnAllPlanetLayers>False</canOccurOnAllPlanetLayers>
    <ignoreConfigErrors>False</ignoreConfigErrors>
    <ignoreIllegalLabelCharacterConfigError>False</ignoreIllegalLabelCharacterConfigError>
    
  </QuestScriptDef>
</Defs>